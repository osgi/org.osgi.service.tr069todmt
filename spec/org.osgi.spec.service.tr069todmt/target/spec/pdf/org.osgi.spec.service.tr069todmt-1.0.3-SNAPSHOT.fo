               <fo:block id="i712177">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>131.3.10.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Date</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">If the destination type is <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">string</fo:inline> then a date must
        be formatted according to the TR-069 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">dateTime</fo:inline> format.
        <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline> and <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline> must be set to a <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_DATETIME">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_DATETIME</fo:inline>
                     </fo:basic-link> typed destination with just the day or just
        the time respectively. That is, the <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline> must be treated as a relative time for
        TR-069.</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">Date</fo:inline> object of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">Dmt Data</fo:inline> object
        represents the three different <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_DATETIME">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_DATETIME</fo:inline>
                     </fo:basic-link> types with the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">getTime()</fo:inline> method.
        The value of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">getTime()</fo:inline> indicates what type of date time
        it is:</fo:block>
                  <fo:list-block space-before.optimum="1em"
                                 space-before.minimum="0.8em"
                                 space-before.maximum="1.2em"
                                 space-after.optimum="1em"
                                 space-after.minimum="0.8em"
                                 space-after.maximum="1.2em"
                                 provisional-label-separation="0.2em"
                                 provisional-distance-between-starts="12pt"
                                 id="d207e1589">
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d207e1590">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:inline font-style="italic">Unknown</fo:inline> - The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">getTime()</fo:inline>
            method must be 0</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d207e1596">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:inline font-style="italic">Relative</fo:inline> - The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">getTime()</fo:inline>
            method must return a negative number</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                     <fo:list-item space-before.optimum="2pt"
                                   space-before.minimum="2pt"
                                   space-before.maximum="2pt"
                                   id="d207e1602">
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block>•</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>
                              <fo:block>
                                 <fo:inline font-style="italic">Absolute</fo:inline> - The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">getTime()</fo:inline>
            method must return a positive number</fo:block>
                           </fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">If a <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline>, or <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline> is converted to a string the string
        representation of <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_DATETIME">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_DATETIME</fo:inline>
                     </fo:basic-link> must be used, including the form of unknown,
        relative, or absolute. A <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline> stands for an unknown time.</fo:block>
               </fo:block>
               <fo:block id="d207e1620">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>131.3.10.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Binary</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">The Dmt Admin service has several binary formats ( <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">???</fo:inline>, and <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">???</fo:inline> ) that can be converted to</fo:inline>
                     <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_HEXBINARY">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_HEXBINARY</fo:inline>
                     </fo:basic-link> and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_BASE64">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_BASE64</fo:inline>
                     </fo:basic-link>. All binary formats maintain their data as a
        <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">byte[]</fo:inline>. Conversion is therefore straightforward encoding
        of the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">byte[]</fo:inline> into the proper encoding: hex or base
        64.</fo:block>
               </fo:block>
               <fo:block id="d207e1640">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>131.3.10.3</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>Number</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">The TR-069 Connector must convert numeric values ( <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline>, and <fo:inline color="blue"
                                font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                letter-spacing="0.08em"
                                hyphenate="false">???</fo:inline> ) to <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_INT">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_INT</fo:inline>
                     </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_LONG">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_LONG</fo:inline>
                     </fo:basic-link>, <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_UNSIGNED_INT">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_UNSIGNED_INT</fo:inline>
                     </fo:basic-link>, and <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="org.osgi.service.tr069todmt.TR069Connector.TR069_UNSIGNED_LONG">
                        <fo:inline color="blue"
                                   font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                   letter-spacing="0.08em"
                                   hyphenate="false">TR069_UNSIGNED_LONG</fo:inline>
                     </fo:basic-link> values. Float values must be rounded according
        to the standard Java rounding rules when converted to an
        <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">integer</fo:inline> or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">long</fo:inline>.</fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">A conversion must not exceed the range of the destination type.
        That is, if an integer is converted to an unsigned <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">int</fo:inline>
        then negative values must be treated as an error. If the destination
        type is <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">string</fo:inline> then the numeric value must be calculated
        with the Dmt Data <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">toString</fo:inline> method.</fo:block>
               </fo:block>
               <fo:block id="i713365">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>131.3.10.4</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>List</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
                     <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                font-size="9pt"
                                letter-spacing="0.08em">LIST</fo:inline> nodes with primitive children must be
        converted to a comma separated list. If the children nodes are
        interior nodes then an error must be raised. The values of the comma
        separated list must come from the children of the value node. Each of
        these children must be converted to a string type according to <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                    xmlns:xlink="http://www.w3.org/1999/xlink"
                                    internal-destination="service.tr069todmt-dmt2tr069">
                        <fo:inline color="inherit"
                                   font-family="inherit"
                                   letter-spacing="inherit"
                                   hyphenate="inherit">Table 131.6</fo:inline>
                     </fo:basic-link>. These children must then be
        escaped and concatenated with a comma as separator according to the
        rules of TR-106 comma separated lists. Nested lists are not
        allowed.</fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="i777240">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>131.3.11</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>TR-069 to Dmt Data Conversion</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">A TR-069 Parameter value consists of a string and a type
      identifier from the set of TR-069 types, see <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i819800">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">
                        <fo:inline font-style="italic">Data Types</fo:inline> on page <fo:page-number-citation ref-id="i819800"/>
                     </fo:inline>
                  </fo:basic-link>.
      The conversion is depicted in <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                 xmlns:xlink="http://www.w3.org/1999/xlink"
                                 internal-destination="i728691">
                     <fo:inline color="inherit"
                                font-family="inherit"
                                letter-spacing="inherit"
                                hyphenate="inherit">Figure 131.7</fo:inline>
                  </fo:basic-link>.</fo:block>
               <fo:block space-before.minimum="0.5em"
                         space-before.optimum="1em"
                         space-before.maximum="2em"
                         space-after.minimum="0.5em"
                         space-after.optimum="1em"
                         space-after.maximum="2em"
                         keep-together.within-column="always"
                         id="d207e1686">
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            font-weight="normal"
                            font-size="9pt"
                            hyphenate="false"
                            space-after.minimum="0.4em"
                            space-after.optimum="0.6em"
                            space-after.maximum="0.8em"
                            start-indent="0pt"
                            font-family="Proforma-Book,ArialUnicodeMS"
                            font-style="italic"
                            keep-with-next.within-column="always">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block>Figure 131.8</fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>TR-069 to DMT</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block id="d207e1688" text-align="center">
                     <fo:external-graphic src="url(file:///home/stbischof/git/OSGI_MIGRATE/osgi_target/org.osgi.service.tr069todmt/spec/org.osgi.spec.service.tr069todmt/src/main/resources/spec/tr069-dmt-conversion.svg)"
                                          width="auto"
                                          height="auto"
                                          content-width="6.214in"
                                          content-height="1.318in"
                                          text-align="center"/>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The destination type is obtained from the corresponding Meta Node.
      If multiple formats are specified in the result of the <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline> method then the most applicable type must be
      used. The following table lists the applicability for each TR-106 data
      type.</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d207e1695">base64        <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>
boolean       <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>
dateTime      <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>
hexBinary     <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>, <fo:inline color="blue"
                             font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             letter-spacing="0.08em"
                             hyphenate="false">???</fo:inline>
int           <fo:inline color="blue"
