                                 </fo:block-container>
                              </fo:table-cell>
                           </fo:table-row>
                        </fo:table-header>
                        <fo:table-body start-indent="0pt" end-indent="0pt">
                           <fo:table-row keep-together.within-column="always">
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline color="blue"
                                               font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               letter-spacing="0.08em"
                                               hyphenate="false">???</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">binary</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block> </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block> </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
                                             padding-top="1pt"
                                             padding-bottom="1pt">
                                 <fo:block>
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">binary</fo:inline>
                                 </fo:block>
                              </fo:table-cell>
                              <fo:table-cell padding-start="0pt"
                                             padding-end="4pt"
